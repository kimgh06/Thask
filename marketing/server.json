{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kimgh06/thask",
  "description": "Dependency-graph MCP server. Tells Claude/Cursor what breaks if you change X. Provenance guards.",
  "repository": {
    "url": "https://github.com/kimgh06/Thask",
    "source": "github"
  },
  "version": "0.6.0",
  "websiteUrl": "https://thask.kimgh06.com",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@thask-org/cli",
      "version": "0.6.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "isRequired": true
        },
        {
          "type": "positional",
          "value": "serve",
          "isRequired": true
        }
      ],
      "environmentVariables": [
        {
          "name": "THASK_URL",
          "description": "URL of your Thask server (e.g. https://thask.kimgh06.com or http://localhost:7244). Can also be set via `thask config set url <url>`.",
          "isRequired": true
        },
        {
          "name": "THASK_TOKEN",
          "description": "API key for your Thask account. Generate via `thask login` (browser flow, recommended) or in the web UI settings.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tool_count": 25,
      "categories": ["development", "graph", "code-intelligence", "dependency-analysis"],
      "tags": [
        "dependency-graph",
        "claude-code",
        "cursor",
        "codex",
        "code-intelligence",
        "impact-analysis",
        "audit-log",
        "provenance",
        "go",
        "typescript"
      ]
    }
  }
}
