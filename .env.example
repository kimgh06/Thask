# Docker Compose environment variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Required: random 64+ character string for session signing
SESSION_SECRET=

# Optional: override defaults
# POSTGRES_PASSWORD=thask_password
# APP_URL=http://localhost:7243
# BACKEND_URL=http://backend:7244
# CAPTURE_PORT=7241
# BROWSER_WS_ENDPOINT=ws://browserless:3000
# CAPTURE_INTERNAL_SECRET=
# CAPTURE_TIMEOUT_SECONDS=30
